  "side_effects": "数据库、控制事件和显式启动/停止接口；本次迁移不调用这些启动接口。",
  "selection_and_retention": "一个Catalog和原子控制写入支持身份去重与三队统一领取，因此通过API共享事务，不复制数据库实现。保留model_schedule/model_identity/model_job：当前CLI、旧卡片合同及禁用/取消测试仍调用它们；它们不是可恢复实验的授权。",
  "runtime_activation": "No automatic start/resume; existing controls and sole owner remain authoritative",
  "physical_source_root": "infrastructure/core",
  "workspace_project": "infrastructure",
  "schema_initialization_cache": {
    "key": "actual loaded initializer bytecode/constants and SQL objects",
    "validation": "required tables/indexes/triggers, reading columns, obsolete seed guard removed, matching derived marker",
    "unchanged": "read-only SQL path, no repeated historical backfill",
    "invalid_or_changed": "original initialization executes, marker written only after all installers complete",
    "no_task_reset": true
  },
  "priority_contract": "passed_correction_priority is derived from immutable original complete passing review assessment and the unchanged source; local claims, mixed backlog, follow-up reviews and status projections share one sort key. Existing arrival time/sequence and missing scores stay intact.",
  "priority_query_scope": {
    "candidates": "current records paper_id set via json_each parameter",
    "correction_evidence": "all matching-original-source corrections for those papers only",
    "scores": "same-version scores/review join for those papers only",
    "empty": "no database query",
    "ranking": "existing passed/manual priority, scores, unknowns and FIFO unchanged",
    "cache": "none"
  },
  "read_checkpoints": {
    "default": "disabled",
    "registration": "per-thread explicit callback; returns prior callback",
    "eligible": "WAL; SELECT; no explicit transaction",
    "pulse": "at least 50ms and every 1000 VM steps",
    "excluded": "writes, explicit transactions, DDL, PRAGMA, other statements and non-WAL",
    "failure": "abort read and rethrow original callback exception",
    "service_or_thread_starts": false
  },
  "manual_seed_priority_contract": "Registered manual root seeds rank first in every runnable stage, including preparation, cross-lane admission, correction successors, retry/recovery scans. Stable original FIFO/score within groups; no preemption, deadline bypass, pause override, extra retry or unknown resend. core.api.workflow_priority__seed_first preserves original recovery record objects.",
  "seed_focus_contract": {
    "control": "seed-focus-control.json, default off; user pauses remain independent",
    "scope": "manual_seed_roots only; ordinary queued work retained, sent work collect-only",
    "trace": "seed-tracking/<paper_id>/trace.json, append-only events and content-addressed original evidence",
    "stalled_seconds": 10800,
    "progress": "qualified-material-v2: hashed complete original answers/current-source card bodies/current-version scientific pass/production completion only; original evidence timestamps and stable IDs, never submission/state/poll/restart/archive; legacy trace bytes retained before clock correction",
    "complete": "Same-source selected candidate or same-trial repaired successor, immutable original scientific content bound to passing review; scientific_verified AND production_contract_complete. Metadata-only finalization is permitted; evidence retained."
  },
  "failure_reason_contract": {
    "normalization": "add automatic failure marker once; preserve existing marked diagnostic bytes",
    "historical_evidence": "no cleanup, counter reset or scientific changes"
  }
}
